---
interface Props {
  title?: string;
}

const { title = 'DevFeed' }: Props = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <!-- Tailwind CSS CDN -->
    <script is:inline src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script is:inline>
      tailwind.config = {
        darkMode: "class",
        theme: {
          extend: {
            colors: {
              "on-secondary-fixed": "#001d33",
              "on-tertiary-fixed-variant": "#6b3b00",
              "inverse-primary": "#00629d",
              "tertiary-fixed-dim": "#ffb875",
              "on-secondary-fixed-variant": "#264969",
              "on-secondary-container": "#97b8dd",
              "primary": "#99cbff",
              "on-background": "#dee3ea",
              "on-primary": "#003354",
              "on-tertiary-fixed": "#2d1600",
              "background": "#0f1419",
              "tertiary": "#ffb875",
              "surface-container-low": "#171c21",
              "on-secondary": "#0a3351",
              "primary-fixed-dim": "#99cbff",
              "inverse-on-surface": "#2c3136",
              "secondary-fixed-dim": "#a8caef",
              "secondary-container": "#264969",
              "surface-container-highest": "#30353b",
              "on-error-container": "#ffdad6",
              "on-surface": "#dee3ea",
              "outline": "#89919d",
              "error-container": "#93000a",
              "tertiary-fixed": "#ffdcc0",
              "secondary-fixed": "#cfe5ff",
              "on-tertiary": "#4b2800",
              "surface-variant": "#30353b",
              "on-error": "#690005",
              "on-tertiary-container": "#472500",
              "primary-fixed": "#cfe5ff",
              "surface-bright": "#353a3f",
              "secondary": "#a8caef",
              "outline-variant": "#3f4851",
              "on-primary-fixed": "#001d33",
              "surface-dim": "#0f1419",
              "error": "#ffb4ab",
              "surface-container": "#1b2025",
              "inverse-surface": "#dee3ea",
              "surface-container-high": "#252a30",
              "tertiary-container": "#db7e00",
              "surface-container-lowest": "#0a0f14",
              "primary-container": "#1d9bf0",
              "surface-tint": "#99cbff",
              "on-primary-container": "#003050",
              "surface": "#0f1419",
              "on-surface-variant": "#bfc7d3",
              "on-primary-fixed-variant": "#004a78"
            },
            borderRadius: {
              DEFAULT: "0.25rem",
              lg: "0.5rem",
              xl: "0.75rem",
              full: "9999px"
            },
            fontFamily: {
              headline: ["Inter"],
              body: ["Inter"],
              label: ["Inter"]
            }
          },
        },
      }
    </script>

    <!-- Material Symbols -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />

    <!-- Google Fonts -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" />

    <!-- Highlight.js theme for code syntax highlighting -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/github-dark.min.css" />

    <!-- Global Styles -->
    <style is:global>
      body {
        background-color: #0f1419;
        color: #dee3ea;
        font-family: 'Inter', sans-serif;
      }

      .material-symbols-outlined {
        font-variation-settings: 'FILL' 0, 'wght' 300, 'GRAD' 0, 'opsz' 24;
      }

      .glass-effect {
        background: rgba(37, 42, 48, 0.85);
        backdrop-filter: blur(12px);
      }

      .inner-glow {
        box-shadow: inset 0 1px 0 0 rgba(63, 72, 81, 0.15);
      }

      /* Markdown / code highlighting styles */
      .prose pre {
        background: #161b22 !important;
        border: 1px solid rgba(63, 72, 81, 0.3);
        border-radius: 0.5rem;
        padding: 1rem;
        overflow-x: auto;
        margin: 0.5rem 0;
      }

      .prose pre code {
        background: transparent !important;
        padding: 0;
        font-size: 0.85em;
        line-height: 1.6;
      }

      .prose code {
        background: rgba(99, 203, 255, 0.1);
        color: #99cbff;
        padding: 0.15em 0.4em;
        border-radius: 0.25rem;
        font-size: 0.875em;
        font-family: 'Consolas', 'Monaco', 'Courier New', monospace;
      }

      .prose blockquote {
        border-left: 3px solid #1d9bf0;
        padding-left: 1rem;
        color: #89919d;
        font-style: italic;
      }

      .prose a {
        color: #1d9bf0;
        text-decoration: underline;
      }

      .prose h1, .prose h2, .prose h3 {
        color: #f8f9fa;
        margin-top: 0.5rem;
        margin-bottom: 0.25rem;
      }

      .prose ul, .prose ol {
        padding-left: 1.5rem;
      }

      .prose ul li::marker {
        color: #1d9bf0;
      }
    </style>
  </head>
  <body class="min-h-screen flex flex-col bg-background text-on-surface">
    <slot />
  </body>
</html>
