---
import NewpostModal from "../pages/newpost_modal.astro";

const token = Astro.cookies.get("token")?.value;
let userData = null;

if (token) {
  try {
    const response = await fetch("http://127.0.0.1:3000/api/auth/me", {
      headers: {
        'Cookie': `token=${token}`
      }
    });

    if (response.ok) {
      const data = await response.json();
      userData = data.user;
    }
  } catch (e) {
    console.error("Error network:", e);
  }
}

const displayName = userData?.name || "Elena Vance";
const displayHandle = userData?.username ? `@${userData.username}` : "@curator_vance";
const initial = displayName.charAt(0).toUpperCase();

let topDevs: { id: number; username: string; name: string }[] = [];
if (token) {
  try {
    const res = await fetch("http://127.0.0.1:3000/api/users/all?limit=10", {
      headers: { 'Cookie': `token=${token}` }
    });
    if (res.ok) {
      const data = await res.json();
      topDevs = (data.users || []).filter((u: any) => u.username !== userData?.username);
    }
  } catch (e) {
    console.error("Error fetching top devs:", e);
  }
}

const currentPath = Astro.url.pathname;

const navLinks = [
  { href: "/dashboard", icon: "home", label: "Home" },
  { href: "#", icon: "search", label: "Explore" },
  { href: "/topliked", icon: "auto_awesome", label: "Top Liked" },
  { href: "#", icon: "notifications", label: "Notifications" },
  { href: "#", icon: "mail", label: "Messages" },
];
---

<!-- Mobile hamburger button -->
<button id="mobileMenuBtn" class="fixed top-4 left-4 z-[55] md:hidden flex items-center justify-center w-10 h-10 rounded-full bg-[#171c21] border border-slate-700/50 text-slate-300">
  <span class="material-symbols-outlined" id="menuIcon">menu</span>
</button>

<!-- Mobile backdrop -->
<div id="sidebarBackdrop" class="fixed inset-0 bg-black/60 z-[49] hidden md:hidden"></div>

<aside id="sidebar" class="fixed h-full w-64 left-0 top-0 bg-[#171c21] flex flex-col py-6 px-4 z-50 transition-transform duration-300 -translate-x-full md:translate-x-0">
  <div class="mb-8 flex items-center gap-3 px-2">
    <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-gradient-to-br from-[#1d9bf0] to-[#99cbff]">
      <span class="material-symbols-outlined text-lg text-[#003050]">
        auto_awesome
      </span>
    </div>

    <div>
      <h1 class="text-xl font-bold leading-none text-[#1d9bf0]">
        DevFeed
      </h1>
      <p class="mt-1 text-[10px] uppercase tracking-widest text-slate-500">
        Developer Community
      </p>
    </div>
  </div>

  <button
    id="openModalBtn"
    class="mb-8 flex w-full items-center justify-center gap-2 rounded-full bg-gradient-to-r from-[#1d9bf0] to-[#99cbff] px-4 py-3 font-semibold text-[#003050] shadow-lg shadow-[#1d9bf0]/10 transition-all duration-200 hover:brightness-110 hover:scale-[1.02] hover:shadow-xl hover:shadow-[#1d9bf0]/20 active:scale-95"
  >
    <span class="material-symbols-outlined text-xl">edit</span>
    <span class="text-sm">New Post</span>
  </button>

  <nav class="mb-8 space-y-1">
    {navLinks.map((link) => {
      const isActive = currentPath === link.href;
      return (
        <a
          href={link.href}
          class={`flex items-center gap-3 py-2 transition-colors duration-200 ${
            isActive
              ? "border-l-4 border-[#99cbff] pl-4 text-[#99cbff]"
              : "rounded-lg pl-5 text-slate-400 hover:bg-[#30353b] hover:text-white"
          }`}
        >
          <span class="material-symbols-outlined">{link.icon}</span>
          <span class="text-sm font-medium">{link.label}</span>
        </a>
      );
    })}
  </nav>

  <div class="flex-grow overflow-y-auto pr-1 no-scrollbar">
    <p class="mb-4 px-5 text-[10px] uppercase tracking-widest text-slate-500">
      Developers
    </p>

    <div class="space-y-1">
      {topDevs.map((dev) => (
        <a href={`/profile/${dev.username}`} class="group flex cursor-pointer items-center justify-between rounded-lg px-5 py-2.5 transition-all duration-200 hover:bg-[#30353b]">
          <div class="flex items-center gap-3">
            <div class="h-8 w-8 rounded-full bg-gradient-to-br from-[#1d9bf0] to-[#99cbff] flex items-center justify-center text-[#003050] font-bold text-sm">
              {dev.name.charAt(0).toUpperCase()}
            </div>
            <span class="truncate text-sm text-slate-300 italic">{dev.name}</span>
          </div>
          <span class="material-symbols-outlined text-xs text-white opacity-0 transition-opacity group-hover:opacity-100">
            chevron_right
          </span>
        </a>
      ))}
      {topDevs.length === 0 && (
        <p class="px-5 text-xs text-slate-500">No developers found</p>
      )}
    </div>
  </div>

  <div class="mt-auto space-y-4 pt-6">
    <div class="space-y-1">
      <a
        href="#"
        class="flex items-center gap-3 rounded-lg py-2 pl-5 text-slate-400 transition-colors duration-200 hover:bg-[#30353b] hover:text-white"
      >
        <span class="material-symbols-outlined">settings</span>
        <span class="text-sm font-medium">Settings</span>
      </a>

      <a
        href="#"
        class="flex items-center gap-3 rounded-lg py-2 pl-5 text-slate-400 transition-colors duration-200 hover:bg-[#30353b] hover:text-white"
      >
        <span class="material-symbols-outlined">help</span>
        <span class="text-sm font-medium">Support</span>
      </a>
    </div>

    <div class="flex cursor-pointer items-center gap-3 rounded-2xl bg-[#252a30] p-3 transition-all duration-200 hover:bg-[#30353b]">
      {userData ? (
        <div class="h-10 w-10 rounded-full border border-slate-700 bg-[#1d9bf0]/20 flex items-center justify-center text-[#1d9bf0] font-bold">
          {initial}
        </div>
      ) : (
        <img
          src="https://lh3.googleusercontent.com/aida-public/AB6AXuCkMU-4UmL7RNnqpiYRjFd1KcWjeCf8o72PxinskAq3jqTMRoqLKE67nO-Qb8aCv26QBEjtxzgxVidkBPdFLzT2L7nwUIMuWKuZKXg3TanYYtJmq4o8587znjd2FErmJ95BTArzAvSIeEuIfNlenfht_HK2DssA2VUy2TzkE1f2-LS8oyJnYEzs8_4eNhLz9lEPOw44VZD_zLmexr40x8JW6DxCI2TWRYebVKqKz6nj5PMU1EqCxzS_yqwj-cvzFQG3NBs-kTIHgqk"
          alt="User profile"
          class="h-10 w-10 rounded-full border border-slate-700 object-cover"
        />
      )}

      <div class="min-w-0">
        <p class="truncate text-sm font-bold text-white">
          {displayName}
        </p>
        <p class="truncate text-[11px] text-slate-400">
          {displayHandle}
        </p>
      </div>

      <span class="material-symbols-outlined ml-auto text-slate-500">
        unfold_more
      </span>
    </div>
  </div>
</aside>

<div id="modalOverlay" class="hidden fixed inset-0 z-[60] bg-black/50 backdrop-blur-sm">
  <NewpostModal />
</div>

<script>
  const openBtn = document.getElementById('openModalBtn');
  const modal = document.getElementById('modalOverlay');

  openBtn?.addEventListener('click', () => {
    modal?.classList.remove('hidden');
  });

  modal?.addEventListener('click', (e) => {
    if (e.target === modal) {
      modal.classList.add('hidden');
    }
  });

  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (target.closest('#closeModalBtn')) {
      modal?.classList.add('hidden');
    }
  });

  // Mobile sidebar toggle
  const sidebar = document.getElementById('sidebar');
  const mobileMenuBtn = document.getElementById('mobileMenuBtn');
  const backdrop = document.getElementById('sidebarBackdrop');
  const menuIcon = document.getElementById('menuIcon');

  function openSidebar() {
    sidebar?.classList.remove('-translate-x-full');
    backdrop?.classList.remove('hidden');
    if (menuIcon) menuIcon.textContent = 'close';
  }

  function closeSidebar() {
    sidebar?.classList.add('-translate-x-full');
    backdrop?.classList.add('hidden');
    if (menuIcon) menuIcon.textContent = 'menu';
  }

  mobileMenuBtn?.addEventListener('click', () => {
    const isOpen = !sidebar?.classList.contains('-translate-x-full');
    isOpen ? closeSidebar() : openSidebar();
  });

  backdrop?.addEventListener('click', closeSidebar);

  // Close sidebar when navigating on mobile
  sidebar?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      if (window.innerWidth < 768) closeSidebar();
    });
  });
</script>

<style>
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
</style>
