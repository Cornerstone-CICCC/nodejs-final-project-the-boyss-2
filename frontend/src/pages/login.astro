---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Login | DevFeed">
  <header class="w-full bg-[#0f1419] font-['Inter'] antialiased tracking-tight sticky top-0 z-50">
    <div class="flex justify-between items-center px-6 py-4 w-full max-w-screen-2xl mx-auto">
      <div class="text-xl font-bold tracking-tighter text-slate-50 dark:text-white">DevFeed</div>
      <div class="hidden md:flex items-center gap-8">
        <span class="text-slate-400 font-medium hover:text-[#99cbff] transition-all duration-200 ease-in-out cursor-pointer">Support</span>
      </div>
    </div>
  </header>

  <main class="flex-grow flex items-center justify-center px-4 py-12">
    <div class="w-full max-w-[420px] bg-surface-container-low rounded-xl p-8 md:p-12 relative overflow-hidden">
      <div class="absolute top-0 left-0 w-1 h-full bg-primary-container"></div>
      <div class="mb-10 text-center md:text-left">
        <h1 class="text-2xl font-bold tracking-tight text-on-surface mb-2">Welcome Back</h1>
        <p class="text-on-surface-variant text-sm font-medium tracking-wide">Continue your curated digital experience.</p>
      </div>
      <form id="loginForm" class="space-y-6">
        <div class="space-y-2">
          <label class="text-[0.75rem] uppercase tracking-[0.05em] font-semibold text-outline">Email Address</label>
          <div class="relative flex items-center">
            <span class="material-symbols-outlined absolute left-4 text-outline text-[20px]">alternate_email</span>
            <input name="email" class="w-full bg-surface-container-high border-none rounded-lg py-3 pl-12 pr-4 text-on-surface placeholder:text-outline-variant focus:ring-1 focus:ring-primary-container inner-glow transition-all duration-200" placeholder="curator@kinetic.dialogue" type="email" required />
          </div>
        </div>
        <div class="space-y-2">
          <div class="flex justify-between items-end">
            <label class="text-[0.75rem] uppercase tracking-[0.05em] font-semibold text-outline">Password</label>
            <a class="text-[0.7rem] uppercase tracking-[0.05em] text-primary hover:text-white transition-colors" href="#">Forgot Password</a>
          </div>
          <div class="relative flex items-center">
            <span class="material-symbols-outlined absolute left-4 text-outline text-[20px]">lock</span>
            <input name="password" class="w-full bg-surface-container-high border-none rounded-lg py-3 pl-12 pr-4 text-on-surface placeholder:text-outline-variant focus:ring-1 focus:ring-primary-container inner-glow transition-all duration-200" placeholder="••••••••" type="password" required />
          </div>
        </div>
        <div id="errorMsg" class="text-error text-sm hidden"></div>
        <button class="w-full py-3.5 bg-gradient-to-r from-primary-container to-primary text-on-primary-container font-bold rounded-full active:scale-95 transition-all duration-200 ease-in-out shadow-lg shadow-primary-container/10" type="submit">Login</button>
      </form>
      <div class="mt-10 pt-8 border-t border-outline-variant/10 text-center">
        <p class="text-on-surface-variant text-sm">New to DevFeed? <a class="text-primary font-semibold hover:underline ml-1" href="/register">Sign up</a></p>
      </div>
    </div>
    <div class="fixed -bottom-20 -right-20 w-96 h-96 bg-primary/5 rounded-full blur-[100px] pointer-events-none"></div>
    <div class="fixed top-1/4 -left-20 w-64 h-64 bg-tertiary/5 rounded-full blur-[80px] pointer-events-none"></div>
  </main>

  <footer class="bg-[#0f1419] border-t border-slate-800/20 font-['Inter'] text-[0.75rem] uppercase tracking-[0.05em]">
    <div class="flex flex-col md:flex-row justify-between items-center px-8 py-10 w-full gap-4 max-w-screen-2xl mx-auto">
      <div class="text-slate-500">&copy; 2024 DevFeed.</div>
      <div class="flex gap-6">
        <a class="text-slate-500 hover:text-slate-300 transition-colors cursor-pointer" href="#">Privacy Policy</a>
        <a class="text-slate-500 hover:text-slate-300 transition-colors cursor-pointer" href="#">Terms of Service</a>
        <a class="text-slate-500 hover:text-slate-300 transition-colors cursor-pointer" href="#">Cookie Policy</a>
        <a class="text-slate-500 hover:text-slate-300 transition-colors cursor-pointer" href="#">Accessibility</a>
      </div>
    </div>
  </footer>
</Layout>

<script>
  // Redirect to dashboard if already logged in
  fetch('http://localhost:3000/api/auth/me', { credentials: 'include' })
    .then((res) => { if (res.ok) window.location.href = '/dashboard'; });

  const loginForm = document.getElementById('loginForm') as HTMLFormElement;
  const errorMsg = document.getElementById('errorMsg') as HTMLDivElement;

  loginForm.addEventListener('submit', async (e: SubmitEvent) => {
    e.preventDefault();
    errorMsg.classList.add('hidden');

    const formData = new FormData(e.target as HTMLFormElement);
    const data = {
      email: formData.get('email') as string,
      password: formData.get('password') as string
    };

    try {
      const res: Response = await fetch('http://localhost:3000/api/auth/login', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'include',
        body: JSON.stringify(data)
      });

      const result: { message?: string } = await res.json();

      if (res.ok) {
        window.location.href = '/dashboard';
      } else {
        errorMsg.textContent = result.message || 'Login failed';
        errorMsg.classList.remove('hidden');
      }
    } catch {
      errorMsg.textContent = 'Network error. Please try again.';
      errorMsg.classList.remove('hidden');
    }
  });
</script>
