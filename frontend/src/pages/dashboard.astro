---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Dashboard | DevFeed">
  <!-- Header -->
  <header class="w-full bg-surface-container font-['Inter'] antialiased tracking-tight sticky top-0 z-50 border-b border-outline-variant/10">
    <div class="flex justify-between items-center px-6 py-4 w-full max-w-screen-2xl mx-auto">
      <div class="text-xl font-bold tracking-tighter text-slate-50">DevFeed</div>
      <div class="flex items-center gap-6">
        <span id="userName" class="text-on-surface-variant text-sm font-medium hidden md:block"></span>
        <button id="logoutBtn" class="flex items-center gap-2 text-sm font-medium text-outline hover:text-error transition-colors cursor-pointer">
          <span class="material-symbols-outlined text-[20px]">logout</span>
          Logout
        </button>
      </div>
    </div>
  </header>

  <main class="flex-grow w-full max-w-screen-2xl mx-auto px-6 py-8">
    <!-- Welcome Section -->
    <div class="mb-8">
      <h1 class="text-3xl font-bold tracking-tight text-on-surface mb-1">Welcome back, <span id="userGreeting" class="text-primary">...</span></h1>
      <p class="text-on-surface-variant text-sm">Here's your DevFeed overview.</p>
    </div>

    <!-- Stats Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
      <div class="bg-surface-container-low rounded-xl p-6 border border-outline-variant/10">
        <div class="flex items-center gap-3 mb-3">
          <span class="material-symbols-outlined text-primary text-[24px]">article</span>
          <span class="text-[0.75rem] uppercase tracking-[0.05em] font-bold text-outline">Posts</span>
        </div>
        <p class="text-3xl font-bold text-on-surface">0</p>
        <p class="text-on-surface-variant text-xs mt-1">No posts yet</p>
      </div>
      <div class="bg-surface-container-low rounded-xl p-6 border border-outline-variant/10">
        <div class="flex items-center gap-3 mb-3">
          <span class="material-symbols-outlined text-tertiary text-[24px]">group</span>
          <span class="text-[0.75rem] uppercase tracking-[0.05em] font-bold text-outline">Followers</span>
        </div>
        <p class="text-3xl font-bold text-on-surface">0</p>
        <p class="text-on-surface-variant text-xs mt-1">Start connecting</p>
      </div>
      <div class="bg-surface-container-low rounded-xl p-6 border border-outline-variant/10">
        <div class="flex items-center gap-3 mb-3">
          <span class="material-symbols-outlined text-secondary text-[24px]">chat_bubble</span>
          <span class="text-[0.75rem] uppercase tracking-[0.05em] font-bold text-outline">Messages</span>
        </div>
        <p class="text-3xl font-bold text-on-surface">0</p>
        <p class="text-on-surface-variant text-xs mt-1">No new messages</p>
      </div>
    </div>

    <!-- Feed Placeholder -->
    <div class="bg-surface-container-low rounded-xl p-8 border border-outline-variant/10 text-center">
      <span class="material-symbols-outlined text-outline text-[48px] mb-4 block">dynamic_feed</span>
      <h2 class="text-lg font-bold text-on-surface mb-2">Your feed is empty</h2>
      <p class="text-on-surface-variant text-sm max-w-md mx-auto">Start following other developers to see their posts here. Share your own thoughts and code snippets with the community.</p>
    </div>
  </main>

  <!-- Footer -->
  <footer class="bg-[#0f1419] border-t border-slate-800/20 font-['Inter'] text-[0.75rem] uppercase tracking-[0.05em]">
    <div class="flex flex-col md:flex-row justify-between items-center px-8 py-10 w-full gap-4 max-w-screen-2xl mx-auto">
      <div class="text-slate-500">&copy; 2024 DevFeed.</div>
      <div class="flex gap-6">
        <a class="text-slate-500 hover:text-slate-300 transition-colors cursor-pointer" href="#">Privacy Policy</a>
        <a class="text-slate-500 hover:text-slate-300 transition-colors cursor-pointer" href="#">Terms of Service</a>
      </div>
    </div>
  </footer>
</Layout>

<script>
  import { requireAuth, logout } from '../lib/auth';

  const user = await requireAuth();

  const userGreeting = document.getElementById('userGreeting') as HTMLSpanElement;
  const userName = document.getElementById('userName') as HTMLSpanElement;

  userGreeting.textContent = user.name.split(' ')[0];
  userName.textContent = `@${user.username}`;

  const logoutBtn = document.getElementById('logoutBtn') as HTMLButtonElement;
  logoutBtn.addEventListener('click', () => logout());
</script>
