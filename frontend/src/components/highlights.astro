---
// Highlights Component - Featured Content Section
interface HighlightItem {
  title: string;
  description: string;
  insights?: string[];
  buttons?: Array<{ label: string; action?: string }>;
}

interface Props {
  items?: HighlightItem[];
}

const defaultItems = [
  {
    title: "The Paradox of Empty Space",
    description: "Clean design feels 'empty' when it lacks ++Intentional Anchors**. Without structural hierarchy, the eye wanders without purpose. High-density data doesn't need less information; it needs better ++Tonal Layering**.",
    insights: [
      "By using shifts in surface value (#f17c21 to #252a30) instead of hard borders, we create a psychological map of importance that feels intuitive rather than restrictive."
    ],
    buttons: [
      { label: "Synthesize More", action: "synthesize" },
      { label: "Fact Check", action: "fact-check" }
    ]
  }
];

const { items = defaultItems } = Astro.props;
---

<div class="space-y-4 mb-6">
  {items.map((item) => (
    <div class="rounded-2xl border border-slate-700 bg-gradient-to-br from-[#1d2d3d]/30 to-[#0f1419]/30 p-6 backdrop-blur-sm hover:border-[#1d9bf0]/50 transition-colors duration-200">
      {/* Header with Icon */}
      <div class="flex items-start justify-between mb-4">
        <div class="flex items-center gap-3">
          <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-[#1d9bf0]/20">
            <span class="material-symbols-outlined text-[#1d9bf0]">
              auto_awesome
            </span>
          </div>
          <span class="text-[11px] font-bold tracking-widest uppercase text-[#1d9bf0]">
            Curator Intelligence
          </span>
        </div>
        <button class="text-slate-500 hover:text-white transition-colors">
          <span class="material-symbols-outlined">more_vert</span>
        </button>
      </div>

      {/* Title */}
      <h3 class="text-lg font-bold text-white mb-3 hover:text-[#1d9bf0] cursor-pointer transition-colors">
        {item.title}
      </h3>

      {/* Description */}
      <p class="text-slate-300 text-sm mb-4 leading-relaxed">
        {item.description}
      </p>

      {/* Insights */}
      {item.insights && item.insights.length > 0 && (
        <div class="bg-[#0f1419]/50 rounded-lg p-3 mb-4 border border-slate-700/50">
          {item.insights.map((insight) => (
            <p class="text-xs text-slate-400 leading-relaxed">
              {insight}
            </p>
          ))}
        </div>
      )}

      {/* Action Buttons */}
      {item.buttons && item.buttons.length > 0 && (
        <div class="flex gap-2">
          {item.buttons.map((btn) => (
            <button class="px-4 py-1.5 rounded-lg bg-slate-800 text-xs font-medium text-slate-300 hover:bg-slate-700 hover:text-white transition-colors border border-slate-700 hover:border-slate-600">
              {btn.label}
            </button>
          ))}
        </div>
      )}
    </div>
  ))}
</div>
