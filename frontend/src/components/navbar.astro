---
import NewpostModal from "../pages/newpost_modal.astro";

const token = Astro.cookies.get("token")?.value;
let userData = null;

if (token) {
  try {
    const response = await fetch("http://127.0.0.1:3000/api/users/me", {
      headers: { 
        'Authorization': `Bearer ${token}` 
      }
    });

    if (response.ok) {
      const data = await response.json();
      userData = data.user;
    }
  } catch (e) {
    console.error("Error network:", e);
  }
}

const displayName = userData?.name || "Elena Vance";
const displayHandle = userData?.username ? `@${userData.username}` : "@curator_vance";
const initial = displayName.charAt(0).toUpperCase();
---

