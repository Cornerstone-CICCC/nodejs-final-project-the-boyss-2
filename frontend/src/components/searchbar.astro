---
// Searchbar Component
---

<div class="flex items-center justify-center mb-6">
  <div class="relative w-full max-w-md">
    <input
      type="text"
      placeholder="Search the dialogue..."
      class="w-full rounded-full bg-[#252a30] py-2.5 pl-4 pr-4 text-sm text-white placeholder-slate-500 border border-slate-700 transition-all duration-200 focus:outline-none focus:border-[#1d9bf0] focus:ring-2 focus:ring-[#1d9bf0]/20"
    />
    <span class="material-symbols-outlined absolute right-3 top-2.5 text-slate-500 pointer-events-none">
      search
    </span>
  </div>
</div>

<style>
  input::placeholder {
    color: rgb(100, 116, 139);
  }
</style>
