---
// Sidebar.astro
import NewpostModal from "../pages/newpost_modal.astro";
---

<aside class="fixed left-0 top-0 flex h-screen w-64 flex-col bg-[#171c21] px-4 py-6">
  <!-- Brand -->
  <div class="mb-8 flex items-center gap-3 px-2">
    <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-gradient-to-br from-[#1d9bf0] to-[#99cbff]">
      <span class="material-symbols-outlined text-lg text-[#003050]">
        auto_awesome
      </span>
    </div>

    <div>
      <h1 class="text-xl font-bold leading-none text-[#1d9bf0]">
        DevFeed
      </h1>
      <p class="mt-1 text-[10px] uppercase tracking-widest text-slate-500">
        Developer Community
      </p>
    </div>
  </div>

  <!-- New Post Button -->
  <button
    id="openModalBtn"
    class="mb-8 flex w-full items-center justify-center gap-2 rounded-full bg-gradient-to-r from-[#1d9bf0] to-[#99cbff] px-4 py-3 font-semibold text-[#003050] shadow-lg shadow-[#1d9bf0]/10 transition-all duration-200 hover:brightness-110 hover:scale-[1.02] hover:shadow-xl hover:shadow-[#1d9bf0]/20 active:scale-95"
  >
    <span class="material-symbols-outlined text-xl">edit</span>
    <span class="text-sm">New Post</span>
  </button>

  <!-- Navigation -->
  <nav class="mb-8 space-y-1">
    <a
      href="#"
      class="flex items-center gap-3 border-l-4 border-[#99cbff] py-2 pl-4 text-[#99cbff]"
    >
      <span class="material-symbols-outlined">home</span>
      <span class="text-sm font-medium">Home</span>
    </a>

    <a
      href="#"
      class="flex items-center gap-3 rounded-lg py-2 pl-5 text-slate-400 transition-colors duration-200 hover:bg-[#30353b] hover:text-white"
    >
      <span class="material-symbols-outlined">search</span>
      <span class="text-sm font-medium">Explore</span>
    </a>

    <a
      href="#"
      class="flex items-center gap-3 rounded-lg py-2 pl-5 text-slate-400 transition-colors duration-200 hover:bg-[#30353b] hover:text-white"
    >
      <span class="material-symbols-outlined">auto_awesome</span>
      <span class="text-sm font-medium">Top Liked</span>
    </a>

    <a
      href="#"
      class="flex items-center gap-3 rounded-lg py-2 pl-5 text-slate-400 transition-colors duration-200 hover:bg-[#30353b] hover:text-white"
    >
      <span class="material-symbols-outlined">notifications</span>
      <span class="text-sm font-medium">Notifications</span>
    </a>

    <a
      href="#"
      class="flex items-center gap-3 rounded-lg py-2 pl-5 text-slate-400 transition-colors duration-200 hover:bg-[#30353b] hover:text-white"
    >
      <span class="material-symbols-outlined">mail</span>
      <span class="text-sm font-medium">Messages</span>
    </a>
  </nav>

  <!-- Top Developers -->
 <div class="flex-grow overflow-y-auto pr-1 no-scrollbar">
    <p class="mb-4 px-5 text-[10px] uppercase tracking-widest text-slate-500">
      Top Developers
    </p>

    <div class="space-y-1">
        <div class="group flex cursor-pointer items-center justify-between rounded-lg px-5 py-2.5 transition-all duration-200 hover:bg-[#30353b]">
            
            <div class="space-y-1">
                <!-- Igor Vargas -->
                 <div class="group flex cursor-pointer items-center justify-between rounded-lg px-5 py-2.5 transition-all duration-200 hover:bg-[#30353b]">
                    
                    <div class="flex items-center gap-3">
                        <div class="h-8 w-8 overflow-hidden rounded-full bg-slate-600">
                            <img
                            src="/images/igor_profile.jpeg"
                            alt="Igor Vargas"
                            class="h-full w-full object-cover"
                            />
                        </div>
                        <span class="truncate text-sm text-slate-300">Igor Vargas</span>
                    </div>
                    
                    <span class="material-symbols-outlined text-xs text-slate-600 opacity-0 transition-opacity group-hover:opacity-100">
                        more_horiz
                    </span>
                </div>

                <!-- Arturo Vazquez -->
                 <div class="group flex cursor-pointer items-center justify-between rounded-lg px-5 py-2.5 transition-all duration-200 hover:bg-[#30353b]">
                    <div class="flex items-center gap-3">
                        <div class="h-8 w-8 overflow-hidden rounded-full bg-slate-600">
                            <img
                            src="/images/arturo_profile.jpeg"
                            alt="Arturo Vazquez"
                            class="h-full w-full object-cover"
                            />
                        </div>
                        <span class="truncate text-sm text-slate-300">Arturo Vazquez</span>
                    </div>
                    
                    <span class="material-symbols-outlined text-xs text-slate-600 opacity-0 transition-opacity group-hover:opacity-100">
                        more_horiz
                    </span>
                </div>

                <!-- Leonardo Costa -->
                 <div class="group flex cursor-pointer items-center justify-between rounded-lg px-5 py-2.5 transition-all duration-200 hover:bg-[#30353b]">
                    <div class="flex items-center gap-3">
                        <div class="h-8 w-8 overflow-hidden rounded-full bg-slate-600">
                            <img
                            src="/images/leo_profile.jpeg"
                            alt="Leonardo Costa"
                            class="h-full w-full object-cover"
                            />
                        </div>
                        <span class="truncate text-sm text-slate-300">Leonardo Costa</span>
                    </div>
                    
                    <span class="material-symbols-outlined text-xs text-slate-600 opacity-0 transition-opacity group-hover:opacity-100">
                        more_horiz
                    </span>
                </div>
            </div>
        </div>
    </div>

  <!-- Footer -->
  <div class="mt-auto space-y-4 pt-6">
    <div class="space-y-1">
      <a
        href="#"
        class="flex items-center gap-3 rounded-lg py-2 pl-5 text-slate-400 transition-colors duration-200 hover:bg-[#30353b] hover:text-white"
      >
        <span class="material-symbols-outlined">settings</span>
        <span class="text-sm font-medium">Settings</span>
      </a>

      <a
        href="#"
        class="flex items-center gap-3 rounded-lg py-2 pl-5 text-slate-400 transition-colors duration-200 hover:bg-[#30353b] hover:text-white"
      >
        <span class="material-symbols-outlined">help</span>
        <span class="text-sm font-medium">Support</span>
      </a>
    </div>

    <div class="flex cursor-pointer items-center gap-3 rounded-2xl bg-[#252a30] p-3 transition-all duration-200 hover:bg-[#30353b]">
      <img
        src="https://lh3.googleusercontent.com/aida-public/AB6AXuCkMU-4UmL7RNnqpiYRjFd1KcWjeCf8o72PxinskAq3jqTMRoqLKE67nO-Qb8aCv26QBEjtxzgxVidkBPdFLzT2L7nwUIMuWKuZKXg3TanYYtJmq4o8587znjd2FErmJ95BTArzAvSIeEuIfNlenfht_HK2DssA2VUy2TzkE1f2-LS8oyJnYEzs8_4eNhLz9lEPOw44VZD_zLmexr40x8JW6DxCI2TWRYebVKqKz6nj5PMU1EqCxzS_yqwj-cvzFQG3NBs-kTIHgqk"
        alt="User profile"
        class="h-10 w-10 rounded-full border border-slate-700 object-cover"
      />

      <div class="min-w-0">
        <p class="truncate text-sm font-bold text-white">
          Elena Vance
        </p>
        <p class="truncate text-[11px] text-slate-400">
          @curator_vance
        </p>
      </div>

      <span class="material-symbols-outlined ml-auto text-slate-500">
        unfold_more
      </span>
    </div>
  </div>
</aside>

<!-- Open and Close Modal -->
 
<div id="modalOverlay" class="hidden fixed inset-0 z-50">
  <NewpostModal />
</div>

<script>
  const openBtn = document.getElementById('openModalBtn');
  const modal = document.getElementById('modalOverlay');

  openBtn?.addEventListener('click', () => {
    modal?.classList.remove('hidden');
  });

  document.addEventListener('click', (e) => {
    const target = e.target;

    if (target instanceof HTMLElement) {
      if (target.id === 'modalOverlay') {
        modal?.classList.add('hidden');
      }

      if (target.closest('#closeModalBtn')) {
        modal?.classList.add('hidden');
      }
    }
  });
</script>

<style>
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }

  .no-scrollbar {
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
</style>